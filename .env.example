# Copy to .env.local; never commit credentials. Phase 2 needs local Supabase + Docker.
APP_ENV=local
SUPABASE_PROJECT_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Hosted environments require explicit, distinct project identities (no provisioning here).
# APP_ENV=staging or production
# SUPABASE_EXPECTED_PROJECT_REF=
# SUPABASE_PRODUCTION_PROJECT_REF=
# Never put a Supabase service-role or sb_secret_ key in app configuration.

# Optional prepared guidance; unset/disabled leaves lessons fully usable.
TUTOR_MODE=scripted

# Local live testing only: set TUTOR_MODE=live after applying migrations.
# Confirm the provider project has paid billing disabled. This flag is an
# operator assertion, not a billing API check or a monetary spending cap.
LLM_FREE_TIER_ONLY=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Other providers need an adapter; unsupported values disable the tutor.

# Server-only scoped receipt signing; generate with npm run tutor:receipts:setup.
# Never use NEXT_PUBLIC_ or reuse the provider key. No service-role app key.
TUTOR_RECEIPT_SIGNING_KEY=
