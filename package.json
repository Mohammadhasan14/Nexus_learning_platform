{
  "name": "nexus_learning_platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run build && npm test && npm run test:flows",
    "test:unit": "node --import tsx tests/unit/security.test.ts",
    "test:db": "node --import tsx tests/database/policies.test.ts && node --import tsx tests/database/learning.test.ts && node --import tsx tests/database/content.test.ts",
    "db:types": "node --import tsx scripts/database-types.ts",
    "db:types:check": "node --import tsx scripts/database-types.ts --check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test:local": "supabase test db",
    "test:flows": "playwright test --config playwright.flows.config.ts",
    "db:env": "node --import tsx scripts/local-env.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
